@model List<CSharpDotNetLearning.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Employees</h2>
            <p class="text-muted mb-0">
                Manage your employee information.
            </p>
        </div>

        <a asp-controller="Employees"
           asp-action="Create"
           class="btn btn-primary">
            + Add Employee
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Employee Name</th>
                            <th>Position</th>
                            <th>Age</th>
                            <th>Salary</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    No employees found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var employee in Model)
                            {
                                <tr>
                                    <td>@employee.Id</td>

                                    <td class="fw-semibold">
                                        @employee.Name
                                    </td>

                                    <td>@employee.Position</td>

                                    <td>@employee.Age</td>

                                    <td>
                                        @employee.Salary.ToString(
                                            "C0",
                                            System.Globalization.CultureInfo.GetCultureInfo("id-ID"))
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">
                                            <!-- Edit Button -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editEmployeeModal"
                                                    data-id="@employee.Id"
                                                    data-name="@employee.Name"
                                                    data-position="@employee.Position"
                                                    data-age="@employee.Age"
                                                    data-salary="@employee.Salary.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                Edit
                                            </button>

                                            <!-- Delete Button -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteEmployeeModal"
                                                    data-id="@employee.Id"
                                                    data-name="@employee.Name">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Edit Employee Modal -->
<div class="modal fade"
     id="editEmployeeModal"
     tabindex="-1"
     aria-labelledby="editEmployeeModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <form asp-controller="Employees"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold"
                            id="editEmployeeModalLabel">
                            Edit Employee
                        </h5>
                        <p class="text-muted small mb-0">
                            Update employee information.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden"
                           id="editEmployeeId"
                           name="id" />

                    <div class="mb-3">
                        <label for="editEmployeeName"
                               class="form-label">
                            Employee Name
                        </label>

                        <input type="text"
                               class="form-control"
                               id="editEmployeeName"
                               name="name"
                               maxlength="100"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="editEmployeePosition"
                               class="form-label">
                            Position
                        </label>

                        <input type="text"
                               class="form-control"
                               id="editEmployeePosition"
                               name="position"
                               maxlength="100"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="editEmployeeAge"
                               class="form-label">
                            Age
                        </label>

                        <input type="number"
                               class="form-control"
                               id="editEmployeeAge"
                               name="age"
                               min="1"
                               max="120"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="editEmployeeSalary"
                               class="form-label">
                            Salary (IDR)
                        </label>

                        <input type="number"
                               class="form-control"
                               id="editEmployeeSalary"
                               name="salary"
                               min="0"
                               step="0.01"
                               required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- Delete Employee Modal -->
<div class="modal fade"
     id="deleteEmployeeModal"
     tabindex="-1"
     aria-labelledby="deleteEmployeeModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <form asp-controller="Employees"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title fw-bold"
                        id="deleteEmployeeModalLabel">
                        Delete Employee
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden"
                           id="deleteEmployeeId"
                           name="id" />

                    <p class="mb-2">
                        Are you sure you want to delete
                        <strong id="deleteEmployeeName"></strong>?
                    </p>

                    <p class="text-muted small mb-0">
                        This action cannot be undone.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Yes, Delete
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Edit Employee Modal
        const editEmployeeModal =
            document.getElementById('editEmployeeModal');

        editEmployeeModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            document.getElementById('editEmployeeId').value =
                button.getAttribute('data-id');

            document.getElementById('editEmployeeName').value =
                button.getAttribute('data-name');

            document.getElementById('editEmployeePosition').value =
                button.getAttribute('data-position');

            document.getElementById('editEmployeeAge').value =
                button.getAttribute('data-age');

            document.getElementById('editEmployeeSalary').value =
                button.getAttribute('data-salary');
        });

        // Delete Employee Modal
        const deleteEmployeeModal =
            document.getElementById('deleteEmployeeModal');

        deleteEmployeeModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            document.getElementById('deleteEmployeeId').value =
                button.getAttribute('data-id');

            document.getElementById('deleteEmployeeName').textContent =
                button.getAttribute('data-name');
        });
    </script>
}