@{
    ViewData["Title"] = "Add Employee";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Add Employee</h2>
        <p class="text-muted">
            Enter the employee information below.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form asp-controller="Employees"
                  asp-action="Create"
                  method="post">

                <div class="mb-3">
                    <label for="name" class="form-label">
                        Employee Name
                    </label>
                    <input type="text"
                           id="name"
                           name="name"
                           class="form-control"
                           placeholder="Enter employee name"
                           required
                           maxlength="100" />
                </div>

                <div class="mb-3">
                    <label for="position" class="form-label">
                        Position
                    </label>
                    <input type="text"
                           id="position"
                           name="position"
                           class="form-control"
                           placeholder="e.g. Software Developer"
                           required
                           maxlength="100" />
                </div>

                <div class="mb-3">
                    <label for="age" class="form-label">
                        Age
                    </label>
                    <input type="number"
                           id="age"
                           name="age"
                           class="form-control"
                           min="1"
                           max="120"
                           required />
                </div>

                <div class="mb-4">
                    <label for="salary" class="form-label">
                        Salary (IDR)
                    </label>
                    <input type="number"
                           id="salary"
                           name="salary"
                           class="form-control"
                           min="0"
                           step="1000"
                           placeholder="e.g. 7500000"
                           required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Employee
                    </button>

                    <a asp-controller="Employees"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>