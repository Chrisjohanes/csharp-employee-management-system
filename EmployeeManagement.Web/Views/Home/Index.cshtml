@model List<CSharpDotNetLearning.Models.Employee>

@{
    ViewData["Title"] = "Dashboard";

    var totalEmployees = Model.Count;
    var totalDepartments = Model
        .Select(e => e.Position)
        .Distinct()
        .Count();
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Employee Dashboard</h2>
        <p class="text-muted">
            Welcome back! Here's your employee overview.
        </p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Total Employees</p>
                    <h2 class="fw-bold mb-0">@totalEmployees</h2>
                    <small class="text-success">Registered employees</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Departments</p>
                    <h2 class="fw-bold mb-0">@totalDepartments</h2>
                    <small class="text-muted">Based on employee positions</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Active Employees</p>
                    <h2 class="fw-bold mb-0">@totalEmployees</h2>
                    <small class="text-success">All registered employees</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">New This Month</p>
                    <h2 class="fw-bold mb-0">—</h2>
                    <small class="text-muted">Requires employee join date</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1">Employee List</h5>
                    <p class="text-muted small mb-0">
                        Employees loaded from the JSON data file.
                    </p>
                </div>

                <a asp-controller="Employees"
                   asp-action="Create"
                   class="btn btn-primary">
                    + Add Employee
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Employee</th>
                            <th>Position</th>
                            <th>Age</th>
                            <th>Salary</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    No employee data available.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var employee in Model)
                            {
                                <tr>
                                    <td>@employee.Id</td>
                                    <td class="fw-semibold">@employee.Name</td>
                                    <td>@employee.Position</td>
                                    <td>@employee.Age</td>
                                    <td>@employee.Salary.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("id-ID"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>