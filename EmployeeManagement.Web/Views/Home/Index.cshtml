
@model List<CSharpDotNetLearning.Models.Employee>

@{
    ViewData["Title"] = "Dashboard";

    var totalEmployees = Model.Count;

    var totalDepartments = Model
        .Select(employee => employee.Position)
        .Distinct()
        .Count();

    var positions = ViewData["Positions"] as List<string>
        ?? new List<string>();

    var searchTerm = ViewData["SearchTerm"]?.ToString();
    var selectedPosition = ViewData["SelectedPosition"]?.ToString();
    var sortBy = ViewData["SortBy"]?.ToString();
}

<div class="container-fluid py-4 px-3 px-lg-4">

    @* Dashboard Header *@
    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mb-4">

        <div>
            <span class="badge rounded-pill text-bg-primary mb-2">
                MANAGEMENT OVERVIEW
            </span>

            <h2 class="fw-bold mb-2">Employee Dashboard</h2>

            <p class="text-secondary mb-0">
                Welcome back! Here's your employee overview.
            </p>
        </div>

        <div class="text-md-end">
            <span class="text-secondary small">
                Employee Management System
            </span>
        </div>
    </div>

    @* Statistics Cards *@
    <div class="row g-3 g-xl-4 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="text-secondary small fw-semibold mb-2">
                                TOTAL EMPLOYEES
                            </p>
                            <h2 class="fw-bold mb-0">@totalEmployees</h2>
                        </div>

                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                    </div>

                    <p class="text-secondary small mb-0">
                        Registered employees
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="text-secondary small fw-semibold mb-2">
                                DEPARTMENTS
                            </p>
                            <h2 class="fw-bold mb-0">@totalDepartments</h2>
                        </div>

                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                            <i class="bi bi-diagram-3 fs-4"></i>
                        </div>
                    </div>

                    <p class="text-secondary small mb-0">
                        Based on employee positions
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="text-secondary small fw-semibold mb-2">
                                ACTIVE EMPLOYEES
                            </p>
                            <h2 class="fw-bold mb-0">@totalEmployees</h2>
                        </div>

                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                            <i class="bi bi-person-check fs-4"></i>
                        </div>
                    </div>

                    <p class="text-secondary small mb-0">
                        All registered employees
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="text-secondary small fw-semibold mb-2">
                                NEW THIS MONTH
                            </p>
                            <h2 class="fw-bold mb-0">—</h2>
                        </div>

                        <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                            <i class="bi bi-person-plus fs-4"></i>
                        </div>
                    </div>

                    <p class="text-secondary small mb-0">
                        Requires employee join date
                    </p>
                </div>
            </div>
        </div>

    </div>

    @* Employee List *@
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-3 p-md-4">

            @* Employee List Header *@
            <div class="employee-list-header mb-4">

                <div class="employee-list-title">
                    <h5 class="fw-bold mb-1">Employee List</h5>

                    <p class="text-secondary small mb-0">
                        Search and manage your employee records.
                    </p>
                </div>

                @* Search, Filter, Sort and Add Employee *@
                <div class="employee-toolbar">

                    <form asp-controller="Home"
                          asp-action="Index"
                          method="get"
                          class="employee-filter-form">

                        <div class="input-group employee-search">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="searchTerm"
                                   value="@searchTerm"
                                   class="form-control"
                                   placeholder="Search name or ID..."
                                   aria-label="Search employee by name or ID" />
                        </div>

                        <select name="position"
                                class="form-select employee-select"
                                aria-label="Filter by position">

                            <option value="">All Positions</option>

                            @foreach (var item in positions)
                            {
                                if (string.Equals(
                                    item,
                                    selectedPosition,
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@item" selected>@item</option>
                                }
                                else
                                {
                                    <option value="@item">@item</option>
                                }
                            }
                        </select>

                        <select name="sortBy"
                                class="form-select employee-select"
                                aria-label="Sort employees">

                            <option value="">Sort by</option>

                            <option value="name"
                                    selected="@(string.Equals(
                                        sortBy,
                                        "name",
                                        StringComparison.OrdinalIgnoreCase))">
                                Name (A–Z)
                            </option>

                            <option value="id"
                                    selected="@(string.Equals(
                                        sortBy,
                                        "id",
                                        StringComparison.OrdinalIgnoreCase))">
                                ID
                            </option>

                            <option value="salary"
                                    selected="@(string.Equals(
                                        sortBy,
                                        "salary",
                                        StringComparison.OrdinalIgnoreCase))">
                                Salary (High–Low)
                            </option>
                        </select>

                        <button type="submit"
                                class="btn btn-outline-primary employee-search-button">
                            <i class="bi bi-funnel me-1"></i>
                            Search
                        </button>

                        @if (!string.IsNullOrWhiteSpace(searchTerm)
                            || !string.IsNullOrWhiteSpace(selectedPosition)
                            || !string.IsNullOrWhiteSpace(sortBy))
                        {
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary employee-reset-button">
                                Reset
                            </a>
                        }
                    </form>

                    <a asp-controller="Employees"
                       asp-action="Create"
                       class="btn btn-primary rounded-3 employee-add-button">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Employee
                    </a>

                </div>
            </div>

            @* Employee Table *@
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="text-secondary small fw-semibold text-uppercase py-3">
                                ID
                            </th>
                            <th class="text-secondary small fw-semibold text-uppercase py-3">
                                Employee
                            </th>
                            <th class="text-secondary small fw-semibold text-uppercase py-3">
                                Position
                            </th>
                            <th class="text-secondary small fw-semibold text-uppercase py-3">
                                Age
                            </th>
                            <th class="text-secondary small fw-semibold text-uppercase py-3 text-nowrap">
                                Salary
                            </th>
                            <th class="text-secondary small fw-semibold text-uppercase py-3 text-end">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-secondary py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                                    <span class="fw-semibold">
                                        No employee data available
                                    </span>

                                    <p class="small mb-0 mt-1">
                                        Try changing your search or filter.
                                    </p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var employee in Model)
                            {
                                <tr>
                                    <td class="text-secondary py-3">
                                        #@employee.Id
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-semibold">
                                            @employee.Name
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <span class="badge rounded-pill bg-light text-dark border fw-normal px-3 py-2">
                                            @employee.Position
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        @employee.Age
                                    </td>

                                    <td class="py-3 text-nowrap fw-semibold">
                                        @employee.Salary.ToString(
                                            "C0",
                                            System.Globalization.CultureInfo.GetCultureInfo("id-ID"))
                                    </td>

                                    @* Action Buttons *@
                                    <td class="py-3 text-end text-nowrap">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary me-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editEmployeeModal-@employee.Id"
                                                title="Edit employee">
                                            <i class="bi bi-pencil-square"></i>
                                            <span class="d-none d-lg-inline">Edit</span>
                                        </button>

                                        <form asp-controller="Employees"
                                              asp-action="Delete"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this employee?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@employee.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete employee">
                                                <i class="bi bi-trash"></i>
                                                <span class="d-none d-lg-inline">Delete</span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                @* Edit Employee Modal *@
                                <div class="modal fade"
                                     id="editEmployeeModal-@employee.Id"
                                     tabindex="-1"
                                     aria-labelledby="editEmployeeModalLabel-@employee.Id"
                                     aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow rounded-4">

                                            <form asp-controller="Employees"
                                                  asp-action="Edit"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@employee.Id" />

                                                <div class="modal-header border-0 pb-0">
                                                    <div>
                                                        <h5 class="modal-title fw-bold"
                                                            id="editEmployeeModalLabel-@employee.Id">
                                                            Edit Employee
                                                        </h5>
                                                        <p class="text-secondary small mb-0">
                                                            Update employee information.
                                                        </p>
                                                    </div>

                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal"
                                                            aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="name-@employee.Id"
                                                               class="form-label fw-semibold">
                                                            Employee Name
                                                        </label>
                                                        <input id="name-@employee.Id"
                                                               type="text"
                                                               name="name"
                                                               class="form-control"
                                                               maxlength="100"
                                                               value="@employee.Name"
                                                               required />
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="position-@employee.Id"
                                                               class="form-label fw-semibold">
                                                            Position
                                                        </label>
                                                        <input id="position-@employee.Id"
                                                               type="text"
                                                               name="position"
                                                               class="form-control"
                                                               maxlength="100"
                                                               value="@employee.Position"
                                                               required />
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="age-@employee.Id"
                                                               class="form-label fw-semibold">
                                                            Age
                                                        </label>
                                                        <input id="age-@employee.Id"
                                                               type="number"
                                                               name="age"
                                                               class="form-control"
                                                               min="18"
                                                               max="65"
                                                               value="@employee.Age"
                                                               required />
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="salary-@employee.Id"
                                                               class="form-label fw-semibold">
                                                            Salary (IDR)
                                                        </label>
                                                        <input id="salary-@employee.Id"
                                                               type="number"
                                                               name="salary"
                                                               class="form-control"
                                                               min="0.01"
                                                               step="0.01"
                                                               value="@employee.Salary.ToString(
                                                                   System.Globalization.CultureInfo.InvariantCulture)"
                                                               required />
                                                    </div>
                                                </div>

                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button"
                                                            class="btn btn-light"
                                                            data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>

                                                    <button type="submit"
                                                            class="btn btn-primary">
                                                        <i class="bi bi-check-lg me-1"></i>
                                                        Save Changes
                                                    </button>
                                                </div>

                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* Employee List Footer *@
            <div class="d-flex flex-column flex-sm-row
                        justify-content-between align-items-sm-center
                        gap-2 mt-3 pt-3 border-top">

                <span class="text-secondary small">
                    Showing @Model.Count employee(s)
                </span>

                <span class="text-secondary small">
                    Data source: JSON repository
                </span>
            </div>

        </div>
    </div>
</div>
